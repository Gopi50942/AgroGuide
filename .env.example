# AgroGuide Environment Configuration Template
# Copy this file to .env.local for local development or .env.production for deployment.

# ── Core Firebase Credentials (Required - Firebase Spark Free Plan) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Note: NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET is deprecated and intentionally unused.

# ── Application Flags ──
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=2026.09-FINAL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI & Vision Model (OpenRouter) ──
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_VISION_MODEL=

# ── Optional Free Media Storage (Cloudinary) ──
# Server-only credentials for public community/diary media. Leave empty for local preview mode.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Mandi Webhook Security (Required for /api/webhooks/mandi) ──
MANDI_WEBHOOK_SECRET=sig_agroguide_mandi_secret_2026

# ── Optional / External Sandboxes (Defaults to NOT_CONFIGURED when empty) ──
AGRISTACK_MODE=sandbox
AGRISTACK_API_KEY=
WDRA_API_KEY=
ENWR_REPOSITORY_ID=
SENTINEL1_SAR_API_KEY=
TWILIO_VOICE_ACCOUNT_SID=
TWILIO_VOICE_AUTH_TOKEN=
AAVIN_API_KEY=
STATE_ODX_GATEWAY_KEY=
